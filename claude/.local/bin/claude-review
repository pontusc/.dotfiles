#!/usr/bin/env bash
set -euo pipefail
# Runs the weekly-review skill in a background Claude session, opens it as a window in the
# reviews tmux session and notifies, the click opens the artifact. Run by claude-review.timer
# on Monday mornings, or by hand with no arguments.

THIS_MONDAY="$(date -d "today -$(($(date +%u) - 1)) days" +%F)"
LAST_MONDAY="$(date -d "${THIS_MONDAY} -7 days" +%F)"
WEEK="$(date -d "${LAST_MONDAY}" +%G-W%V)"
WINDOW="W${WEEK#*-W}"
OUT_DIR="${HOME}/weeklies/reviews"
REPORT="${OUT_DIR}/${LAST_MONDAY}.md"
DOTFILES="${HOME}/dotfiles"
DEADLINE=$((SECONDS + 7200))
POLL_SECONDS=30

fail() {
  notify-send -u critical "Weekly review ${WEEK} failed" "$1, see journalctl --user -u claude-review"
  exit 1
}

mkdir -p "$OUT_DIR"
cd "$DOTFILES"
# The prompt goes first, the tool list flags are variadic and would swallow it.
START_OUTPUT="$(claude --bg "/weekly-review ${LAST_MONDAY}" --model fable --effort high \
  --allowedTools Artifact --disallowedTools "Edit(/${DOTFILES}/**)" 2>&1)" \
  || fail "claude --bg exited non-zero: ${START_OUTPUT}"
shopt -s extglob
START_OUTPUT="${START_OUTPUT//$'\e'\[*([0-9;])m/}"
readarray -t JOB_IDS < <(grep -oP 'backgrounded\W+\K[0-9a-f]{8}' <<<"$START_OUTPUT")
[[ ${#JOB_IDS[@]} -gt 0 ]] || fail "no session id in: ${START_OUTPUT}"
JOB_ID="${JOB_IDS[0]}"
readonly JOB_ID
STATE_FILE="${HOME}/.claude/jobs/${JOB_ID}/state.json"

# done is not final while subagents or background commands are still in flight. Drainable
# monitors, the artifact watch the publish leaves behind, never finish and do not count.
OUTCOME="timeout"
while (( SECONDS < DEADLINE )); do
  read -r STATE IN_FLIGHT < <(jq -r '[.state // "working", ((.inFlight.tasks // 0) - (.inFlight.drainableMonitors // 0))] | @tsv' "$STATE_FILE" 2>/dev/null || printf 'working\t0\n')
  if [[ "$STATE" == "done" && "$IN_FLIGHT" -eq 0 && -s "$REPORT" ]]; then
    OUTCOME="ready"
    break
  fi
  if [[ "$STATE" == "blocked" && "$IN_FLIGHT" -eq 0 ]]; then
    OUTCOME="blocked"
    break
  fi
  sleep "$POLL_SECONDS"
done

ATTACH="claude attach ${JOB_ID}"
tmux new-session -d -s reviews -n "$WINDOW" -c "$DOTFILES" "$ATTACH" 2>/dev/null \
  || tmux new-window -t reviews: -n "$WINDOW" -c "$DOTFILES" "$ATTACH" \
  || fail "tmux window not created"

case "$OUTCOME" in
  ready) BODY="ready, session reviews:${WINDOW}" ;;
  blocked) BODY="waiting for input, session reviews:${WINDOW}" ;;
  *) BODY="not finished after 2h, session reviews:${WINDOW}" ;;
esac
readarray -t ARTIFACT_URLS < <(sed -n '2s/^Artifact: *//p' "$REPORT" 2>/dev/null | grep -oE 'https://claude\.ai/[^[:space:]]+')
TARGET="${ARTIFACT_URLS[0]:-$REPORT}"

# The click wait runs detached so the oneshot unit finishes once the session is done.
NOTIFY_SCRIPT="$(cat <<'EOF'
if [[ "$(notify-send -u critical -A default=Open "$1" "$2")" == "default" ]]; then xdg-open "$3"; fi
EOF
)"
systemd-run --user --collect --quiet --unit "claude-review-notify-${LAST_MONDAY}-$$" \
  bash -c "$NOTIFY_SCRIPT" _ "Weekly review ${WEEK}" "$BODY" "$TARGET"
