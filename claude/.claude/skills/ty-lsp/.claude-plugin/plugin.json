{
  "name": "ty-lsp",
  "description": "Python language server via Astral ty.",
  "author": { "name": "Pontus Curtsson" },
  "lspServers": {
    "ty": {
      "command": "ty",
      "args": ["server"],
      "extensionToLanguage": {
