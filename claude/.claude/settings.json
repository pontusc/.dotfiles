{
  "permissions": {
    "allow": [
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git branch:*)",
      "Bash(ls:*)",
      "Bash(pwd:*)",
      "Bash(which:*)",
      "Bash(type:*)",
      "Bash(man:*)",
      "Bash(echo:*)"
    ],
    "deny": [
      "Bash(rm -rf /*)",
      "Bash(rm -rf /)",
      "Bash(sudo rm:*)",
      "Bash(chmod -R 777:*)",
      "Bash(*curl*|*sh*)",
      "Bash(*wget*|*sh*)",
      "Bash(*curl*|*bash*)",
      "Bash(*wget*|*bash*)",
      "Bash(sudo chmod:*)",
      "Bash(sudo chown:*)"
    ],
    "defaultMode": "default"
  },
  "preferences": {
    "verboseMode": false
  },
  "model": "sonnet"
}
