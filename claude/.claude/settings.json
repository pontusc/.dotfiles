{
  "env": {
    "CLAUDE_CODE_DISABLE_1M_CONTEXT": "1",
    "CLAUDE_CODE_DISABLE_AUTO_MEMORY": "1",
    "CLAUDE_CODE_NO_FLICKER": "1",
    "ENABLE_LSP_TOOL": "1",
    "CLAUDE_CODE_SCROLL_SPEED": "3"
  },
  "permissions": {
    "allow": [
      "Read(*)",
      "Glob(*)",
      "Grep(*)",
      "Bash(*)",
      "WebFetch(*)",
      "WebSearch(*)",
      "Agent(*)",
      "Edit(*)",
      "Write(*)",
      "Skill(*)"
    ],
    "deny": [
      "Bash(sudo:*)",
      "Bash(git push:*)",
      "Bash(git pull:*)",
      "Bash(git tag:*)",
      "Bash(git checkout:*)",
      "Bash(git switch:*)",
      "Bash(git merge:*)",
      "Bash(git rebase:*)",
      "Bash(git reset:*)",
      "Bash(git clean:*)",
      "Bash(git stash:*)",
      "Bash(git remote:*)",
      "Bash(git branch -d:*)",
      "Bash(git branch -D:*)",
      "Bash(talosctl reset:*)",
      "Bash(talosctl upgrade:*)",
      "Bash(talosctl upgrade-k8s:*)",
      "Bash(talosctl bootstrap:*)",
      "Bash(talosctl reboot:*)",
      "Bash(talosctl shutdown:*)",
      "Bash(talosctl etcd remove-member:*)",
      "Bash(talosctl etcd leave:*)",
      "Read(.env)",
      "Read(.env.*)",
      "Edit(.env)",
      "Edit(.env.*)",
      "Read(~/.ssh/**)",
      "Edit(~/.ssh/**)",
      "Read(~/.aws/**)",
      "Edit(~/.aws/**)",
      "Read(~/.kube/**)",
      "Edit(~/.kube/**)",
      "Read(~/.gnupg/**)",
      "Edit(~/.gnupg/**)",
      "Read(~/.talos/**)",
      "Edit(~/.talos/**)",
      "Read(**/*.pem)",
      "Read(**/*.key)",
      "Edit(**/*.pem)",
      "Edit(**/*.key)"
    ],
    "defaultMode": "default"
  },
  "model": "opus",
  "hooks": {
    "Notification": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/home/pontusc/.claude/hooks/notify.sh"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "/home/pontusc/.local/bin/dcg"
          }
        ]
      },
      {
        "matcher": "Read|Bash|Grep|Glob",
        "hooks": [
          {
            "type": "command",
            "command": "/home/pontusc/.claude/hooks/guard-sensitive.sh"
          }
        ]
      }
    ]
  },
  "disableWorkflows": true,
  "statusLine": {
    "type": "command",
    "command": "bash /home/pontusc/.claude/statusline-command.sh"
  },
  "enabledPlugins": {
    "plan@plans": true
  },
  "extraKnownMarketplaces": {
    "plans": {
      "source": {
        "source": "github",
        "repo": "pontusc-alchemy/claudeplans",
        "ref": "v0.0.6"
      }
    }
  },
  "sandbox": {
    "enabled": false
  },
  "syntaxHighlightingDisabled": false,
  "promptSuggestionEnabled": false,
  "awaySummaryEnabled": false,
  "tui": "fullscreen",
  "theme": "dark-ansi",
  "inputNeededNotifEnabled": true,
  "agentPushNotifEnabled": false,
  "preferences": {
    "verboseMode": true
  },
  "remoteControlAtStartup": true
}
