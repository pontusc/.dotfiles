{
  "permissions": {
    "allow": [
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git branch:*)",
      "Bash(git show:*)",
      "Bash(git blame:*)",
      "Bash(ls:*)",
      "Bash(pwd:*)",
      "Bash(which:*)",
      "Bash(type:*)",
      "Bash(man:*)",
      "Bash(echo:*)",
      "Bash(npm test:*)",
      "Bash(npm run test*:*)",
      "Bash(cargo test:*)",
      "Bash(pytest:*)",
      "Bash(python -m pytest:*)",
      "Bash(go test:*)",
      "Bash(make test:*)",
      "Bash(docker ps:*)",
      "Bash(docker logs:*)"
    ],
    "deny": [
      "Bash(rm -rf /*)",
      "Bash(rm -rf /)",
      "Bash(sudo rm:*)",
      "Bash(chmod -R 777:*)",
      "Bash(*curl*|*sh*)",
      "Bash(*wget*|*sh*)",
      "Bash(*curl*|*bash*)",
      "Bash(*wget*|*bash*)",
      "Bash(sudo chmod:*)",
      "Bash(sudo chown:*)"
    ],
    "defaultMode": "default"
  },
  "preferences": {
    "verboseMode": false
  },
  "model": "sonnet"
}
