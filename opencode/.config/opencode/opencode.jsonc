{
  "$schema": "https://opencode.ai/config.json",
  "theme": "system",
  "autoupdate": true,
  "share": "disabled",
  "instructions": ["~/.claude/CLAUDE.md"],
  "permission": {
    "read": "allow",
    "edit": "ask",
    "bash": {
      "*": "ask",
      "sudo *": "deny",
      "rm *": "deny",
      "git *": "deny",
      "git status*": "allow",
      "git diff*": "allow",
      "git log*": "allow",
      "git show*": "allow",
      "git ls-*": "allow",
      "git branch*": "allow",
      "git remote*": "allow",
      "git tag*": "allow",
      "git stash list*": "allow",
      "git stash show*": "allow",
      "git config*": "allow",
      "docker ps*": "allow",
      "docker logs*": "allow",
      "docker images*": "allow",
      "docker inspect*": "allow"
    },
    "webfetch": "ask",
    "doom_loop": "deny",
    "external_directory": "ask"
  },
  "mcp": {}
}
