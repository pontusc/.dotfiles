{
  "$schema": "https://opencode.ai/config.json",
  "theme": "system",
  "autoupdate": true,
  "share": "disabled",

  "permission": {
    "edit": "ask",
    "bash": {
      "git status": "allow",
      "git diff *": "allow",
      "git log *": "allow",
      "git show *": "allow",
      "git branch *": "allow",
      "git stash list": "allow",
      "git commit *": "deny",
      "git push *": "deny",
      "git merge *": "deny",
      "git rebase *": "deny",
      "git reset *": "deny",
      "git checkout *": "ask",
      "git *": "ask",
      "ls *": "allow",
      "cat *": "allow",
      "grep *": "allow",
      "find *": "allow",
      "rm *": "deny",
      "sudo *": "deny",
      "curl *": "ask",
      "wget *": "ask",
      "*": "ask"
    },
    "webfetch": "ask",
    "doom_loop": "deny",
    "external_directory": "deny"
  },

  "tools": {
    "webfetch": false
  },

  "mcp": {}
}
