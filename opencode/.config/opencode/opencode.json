{
  "$schema": "https://opencode.ai/config.json",
  "model": "deepseek/deepseek-v4-pro",
  "update": "disable",
  "permissions": [
    { "action": "read", "resource": "*", "effect": "allow" },
    { "action": "glob", "resource": "*", "effect": "allow" },
    { "action": "grep", "resource": "*", "effect": "allow" },
    { "action": "shell", "resource": "*", "effect": "allow" },
    { "action": "webfetch", "resource": "*", "effect": "allow" },
    { "action": "websearch", "resource": "*", "effect": "allow" },
    { "action": "subagent", "resource": "*", "effect": "allow" },
    { "action": "edit", "resource": "*", "effect": "allow" },
    { "action": "skill", "resource": "*", "effect": "allow" },

    { "action": "shell", "resource": "sudo *", "effect": "deny" },

    { "action": "shell", "resource": "git pull *", "effect": "deny" },
    { "action": "shell", "resource": "git tag *", "effect": "deny" },
    { "action": "shell", "resource": "git checkout *", "effect": "deny" },
    { "action": "shell", "resource": "git merge *", "effect": "deny" },
    { "action": "shell", "resource": "git reset *", "effect": "deny" },
    { "action": "shell", "resource": "git clean *", "effect": "deny" },
    { "action": "shell", "resource": "git stash", "effect": "deny" },
    { "action": "shell", "resource": "git stash -*", "effect": "deny" },
    { "action": "shell", "resource": "git stash push *", "effect": "deny" },
    { "action": "shell", "resource": "git stash save *", "effect": "deny" },
    { "action": "shell", "resource": "git stash pop *", "effect": "deny" },
    { "action": "shell", "resource": "git stash apply *", "effect": "deny" },
    { "action": "shell", "resource": "git stash drop *", "effect": "deny" },
    { "action": "shell", "resource": "git stash clear *", "effect": "deny" },
    { "action": "shell", "resource": "git stash branch *", "effect": "deny" },
    { "action": "shell", "resource": "git switch -f *", "effect": "deny" },
    { "action": "shell", "resource": "git switch --force *", "effect": "deny" },
    { "action": "shell", "resource": "git switch -C *", "effect": "deny" },
    { "action": "shell", "resource": "git switch --force-create *", "effect": "deny" },
    { "action": "shell", "resource": "git switch --discard-changes *", "effect": "deny" },
    { "action": "shell", "resource": "git remote add *", "effect": "deny" },
    { "action": "shell", "resource": "git remote remove *", "effect": "deny" },
    { "action": "shell", "resource": "git remote rm *", "effect": "deny" },
    { "action": "shell", "resource": "git remote rename *", "effect": "deny" },
    { "action": "shell", "resource": "git remote set-url *", "effect": "deny" },
    { "action": "shell", "resource": "git branch -d *", "effect": "deny" },
    { "action": "shell", "resource": "git branch -D *", "effect": "deny" },

    { "action": "shell", "resource": "talosctl reset *", "effect": "deny" },
    { "action": "shell", "resource": "talosctl upgrade *", "effect": "deny" },
    { "action": "shell", "resource": "talosctl upgrade-k8s *", "effect": "deny" },
    { "action": "shell", "resource": "talosctl bootstrap *", "effect": "deny" },
    { "action": "shell", "resource": "talosctl reboot *", "effect": "deny" },
    { "action": "shell", "resource": "talosctl shutdown *", "effect": "deny" },
    { "action": "shell", "resource": "talosctl etcd remove-member *", "effect": "deny" },
    { "action": "shell", "resource": "talosctl etcd leave *", "effect": "deny" },

    { "action": "read", "resource": "*.env", "effect": "deny" },
    { "action": "read", "resource": "*.env.*", "effect": "deny" },
    { "action": "read", "resource": "*.ssh/*", "effect": "deny" },
    { "action": "read", "resource": "*.aws/*", "effect": "deny" },
    { "action": "read", "resource": "*.kube/*", "effect": "deny" },
    { "action": "read", "resource": "*.gnupg/*", "effect": "deny" },
    { "action": "read", "resource": "*.talos/*", "effect": "deny" },
    { "action": "read", "resource": "*.secret/*", "effect": "deny" },
    { "action": "read", "resource": "*.pem", "effect": "deny" },
    { "action": "read", "resource": "*.key", "effect": "deny" },
    { "action": "read", "resource": "*.pfx", "effect": "deny" },
    { "action": "read", "resource": "*.p12", "effect": "deny" },
    { "action": "read", "resource": "*.tfstate", "effect": "deny" },
    { "action": "read", "resource": "*.tfstate.backup", "effect": "deny" },
    { "action": "read", "resource": "*/credentials", "effect": "deny" },
    { "action": "read", "resource": "*/credentials.json", "effect": "deny" },
    { "action": "read", "resource": "*/application_default_credentials.json", "effect": "deny" },
    { "action": "read", "resource": "*/kubeconfig", "effect": "deny" },
    { "action": "read", "resource": "*.kubeconfig", "effect": "deny" },
    { "action": "read", "resource": "*/.npmrc", "effect": "deny" },
    { "action": "read", "resource": "*/.netrc", "effect": "deny" },
    { "action": "read", "resource": "*/authorized_keys", "effect": "deny" },
    { "action": "read", "resource": "*/id_rsa", "effect": "deny" },
    { "action": "read", "resource": "*/id_ed25519", "effect": "deny" },
    { "action": "read", "resource": "*/id_ecdsa", "effect": "deny" },
    { "action": "read", "resource": "*/id_dsa", "effect": "deny" }
  ]
}
