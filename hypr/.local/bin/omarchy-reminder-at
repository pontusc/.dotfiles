#!/usr/bin/env python3
"""Prompt for a reminder day-offset, time-of-day, and message via
omarchy-menu-input, then schedule a realtime (systemd-run --on-calendar)
user timer so the reminder fires at the correct wall-clock time across
suspend/resume.

Usage: omarchy-reminder-at [show|clear]
"""

import itertools
import json
import os
import subprocess
import sys
from collections.abc import Sequence
from datetime import date, datetime, time, timedelta
from pathlib import Path

REMINDER_DIR = Path(os.environ.get("XDG_RUNTIME_DIR", "/tmp")) / "omarchy-reminders"
NOTIFICATION_GLYPH = "󰔛"
TIMER_PATTERNS = ("reminder-at-*.timer", "omarchy-reminder-*.timer")


class TimeParseError(ValueError):
    pass


def cmd(args: Sequence[str], *, check: bool = True) -> subprocess.CompletedProcess[str]:
    return subprocess.run(list(args), capture_output=True, text=True, check=check)


def notify(title: str, body: str | None = None, urgency: str = "low") -> None:
    args = ["omarchy-notification-send", NOTIFICATION_GLYPH, title]
    if body is not None:
        args.append(body)
    args += ["-u", urgency]
    cmd(args)


def notify_invalid(message: str) -> None:
    notify("Invalid reminder", message, "critical")


def usage() -> None:
    print(
        "Usage: omarchy-reminder-at            Prompt for a new reminder\n"
        "       omarchy-reminder-at show       Notify with upcoming reminders\n"
        "       omarchy-reminder-at clear      Cancel all reminders\n"
        "\n"
        "Reminders are user-session systemd timers: they do not survive logout or\n"
        "reboot.",
        file=sys.stderr,
    )


def read_input(prompt: str) -> str:
    try:
        result = cmd(["omarchy-menu-input", prompt], check=False)
    except FileNotFoundError:
        _best_effort_notify_invalid("Reminder input helper failed (exit 127)")
        sys.exit(1)

    # Walker exits 130 (128+SIGINT) when dismissed with Escape — a user
    # cancel, not a helper failure.
    if result.returncode > 1 and result.returncode != 130:
        _best_effort_notify_invalid(f"Reminder input helper failed (exit {result.returncode})")
        sys.exit(1)

    return result.stdout.strip()


def _best_effort_notify_invalid(message: str) -> None:
    try:
        notify_invalid(message)
    except (subprocess.CalledProcessError, FileNotFoundError):
        pass


def is_unsigned_integer(value: str) -> bool:
    # int()/str.isdigit() accept non-ASCII digits (e.g. int('٣') == 3); guard explicitly.
    return bool(value) and value.isascii() and value.isdigit()


def parse_time(input_str: str) -> tuple[int, int]:
    hint = "Enter a time like 830, 1430 or 8:30"

    if input_str.count(":") >= 2:
        raise TimeParseError(hint)

    if ":" in input_str:
        hour_part, _, minute_part = input_str.partition(":")
        if not (is_unsigned_integer(hour_part) and 1 <= len(hour_part) <= 2):
            raise TimeParseError(hint)
        if not (is_unsigned_integer(minute_part) and len(minute_part) == 2):
            raise TimeParseError(hint)
    elif is_unsigned_integer(input_str) and 1 <= len(input_str) <= 4:
        if len(input_str) <= 2:
            hour_part, minute_part = input_str, "00"
        else:
            hour_part, minute_part = input_str[:-2], input_str[-2:]
    else:
        raise TimeParseError(hint)

    hour, minute = int(hour_part), int(minute_part)
    if hour > 23 or minute > 59:
        raise TimeParseError(hint)

    return hour, minute


def format_remaining(seconds: int) -> str:
    minutes, remainder = divmod(seconds, 60)
    if minutes > 0 and remainder > 0:
        return f"{minutes}m {remainder}s"
    if minutes > 0:
        return f"{minutes}m"
    return f"{remainder}s"


def format_hour_minute(moment: datetime) -> str:
    return moment.strftime("%-H:%M")


def list_reminder_timers() -> list[dict]:
    result = cmd(
        ["systemctl", "--user", "list-timers", "--all", "--output=json", *TIMER_PATTERNS],
        check=False,
    )
    if result.returncode != 0 or not result.stdout.strip():
        return []
    return json.loads(result.stdout)


def show_reminders() -> None:
    now = datetime.now()
    lines: list[str] = []

    for entry in list_reminder_timers():
        next_us = entry.get("next", 0)
        if not next_us:
            continue

        # `next` is the absolute realtime epoch in microseconds.
        next_moment = datetime.fromtimestamp(next_us / 1_000_000)
        if next_moment <= now:
            continue

        unit = entry["unit"]
        message_file = REMINDER_DIR / f"{unit.removesuffix('.timer')}.message"
        message = message_file.read_text() if message_file.is_file() else "Reminder"

        remaining = format_remaining(int((next_moment - now).total_seconds()))
        label = format_hour_minute(next_moment)
        if next_moment.date() != now.date():
            label = f"{next_moment.strftime('%a')} {label}"

        lines.append(f"{message} at {label} (in {remaining})")

    if lines:
        notify("Upcoming reminders", "\n".join(lines))
    else:
        notify("Upcoming reminders", "No outstanding reminders")


def clear_reminders() -> None:
    units = [entry["unit"] for entry in list_reminder_timers() if entry.get("unit")]
    if units:
        cmd(["systemctl", "--user", "stop", *units], check=False)

    for message_file in itertools.chain(
        REMINDER_DIR.glob("reminder-at-*.message"),
        REMINDER_DIR.glob("omarchy-reminder-*.message"),
    ):
        message_file.unlink(missing_ok=True)

    notify("All reminders have been cleared")


def prompt_days() -> int | None:
    while True:
        days_input = read_input("Remind in days")
        if not days_input:
            return None

        if is_unsigned_integer(days_input) and int(days_input) <= 3650:
            return int(days_input)

        notify_invalid("Enter the number of days (0-3650)")


def prompt_time(target_date: date) -> datetime | None:
    while True:
        time_input = read_input("At time (HHMM)")
        if not time_input:
            return None

        try:
            hour, minute = parse_time(time_input)
        except TimeParseError as error:
            notify_invalid(str(error))
            continue

        target = datetime.combine(target_date, time(hour, minute))
        # A naive datetime in a spring-forward DST gap does not raise; round-tripping
        # through an epoch timestamp silently resolves it, so detect the gap this way.
        if datetime.fromtimestamp(target.timestamp()) != target:
            notify_invalid("That time doesn't exist on that day")
            continue

        if target > datetime.now():
            return target

        notify_invalid("That time has already passed")


def prompt_message(target: datetime) -> str:
    message = read_input("Reminder message")
    if not message:
        message = f"Your {format_hour_minute(target)} reminder"
    return message


def schedule_reminder(target: datetime, message: str, days: int) -> None:
    REMINDER_DIR.mkdir(parents=True, exist_ok=True)

    now = datetime.now()
    unit = f"reminder-at-{int(target.timestamp())}-{int(now.timestamp())}"
    message_file = REMINDER_DIR / f"{unit}.message"
    message_file.write_text(message)

    fire_message = message
    # omarchy-notification-send misparses a description starting with '-' as a
    # notify-send flag and drops it; a leading space defangs it harmlessly.
    if fire_message.startswith("-"):
        fire_message = " " + fire_message

    cmd(
        [
            "systemd-run",
            "--user",
            "--quiet",
            "--collect",
            f"--on-calendar={target.strftime('%Y-%m-%d %H:%M:%S')}",
            f"--unit={unit}",
            "bash",
            "-c",
            f'omarchy-notification-send "{NOTIFICATION_GLYPH}" "Reminder" "$1" -u critical; rm -f "$2"',
            "bash",
            fire_message,
            str(message_file),
        ]
    )

    if days == 0:
        title = f"Reminder set for {format_hour_minute(target)}"
    else:
        title = f"Reminder set for {target.strftime('%a')} {format_hour_minute(target)}"

    notify(title, message)


def run_interactive_set() -> int:
    days = prompt_days()
    if days is None:
        return 0

    target_date = date.today() + timedelta(days=days)

    target = prompt_time(target_date)
    if target is None:
        return 0

    message = prompt_message(target)
    schedule_reminder(target, message, days)
    return 0


def main() -> int:
    args = sys.argv[1:]

    if not args:
        return run_interactive_set()
    if args[0] == "show":
        show_reminders()
        return 0
    if args[0] == "clear":
        clear_reminders()
        return 0

    usage()
    return 1


if __name__ == "__main__":
    sys.exit(main())
