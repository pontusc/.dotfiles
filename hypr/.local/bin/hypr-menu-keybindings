#!/bin/bash
# Show all Hyprland keybindings in a searchable walker menu.
# Trimmed from Omarchy's omarchy-menu-keybindings:
# https://github.com/basecamp/omarchy/blob/master/bin/omarchy-menu-keybindings

declare -A KEYCODE_SYM_MAP

build_keymap_cache() {
  local keymap
  keymap="$(xkbcli compile-keymap)" || {
    echo "Failed to compile keymap" >&2
    return 1
  }

  while IFS=, read -r code sym; do
    [[ -z $code || -z $sym ]] && continue
    KEYCODE_SYM_MAP["$code"]="$sym"
  done < <(
    awk '
      BEGIN { sec = "" }
      /xkb_keycodes/ { sec = "codes"; next }
      /xkb_symbols/  { sec = "syms";  next }
      sec == "codes" {
        if (match($0, /<([A-Za-z0-9_]+)>\s*=\s*([0-9]+)\s*;/, m)) code_by_name[m[1]] = m[2]
      }
      sec == "syms" {
        if (match($0, /key\s*<([A-Za-z0-9_]+)>\s*\{\s*\[\s*([^, \]]+)/, m)) sym_by_name[m[1]] = m[2]
      }
      END {
        for (k in code_by_name) {
          c = code_by_name[k]
          s = sym_by_name[k]
          if (c != "" && s != "" && s != "NoSymbol") print c "," s
        }
      }
    ' <<<"$keymap"
  )
}

# Replace keycodes/mouse codes with readable symbols
parse_keycodes() {
  while IFS= read -r line; do
    if [[ $line =~ code:([0-9]+) ]]; then
      code="${BASH_REMATCH[1]}"
      echo "${line/code:${code}/${KEYCODE_SYM_MAP[$code]}}"
    elif [[ $line =~ mouse:([0-9]+) ]]; then
      code="${BASH_REMATCH[1]}"
      case "$code" in
        272) symbol="LEFT MOUSE BUTTON" ;;
        273) symbol="RIGHT MOUSE BUTTON" ;;
        274) symbol="MIDDLE MOUSE BUTTON" ;;
        *)   symbol="mouse:${code}" ;;
      esac
      echo "${line/mouse:${code}/$symbol}"
    else
      echo "$line"
    fi
  done
}

# Live binds from Hyprland as unit-separator (\x1f) delimited fields:
# MODS \x1f key \x1f description \x1f dispatcher \x1f arg
# \x1f cannot appear in bind definitions, so fields never break on content.
dynamic_bindings() {
  hyprctl -j binds |
    jq -r '
      .[] |
      ([(if (.modmask / 64 | floor) % 2 == 1 then "SUPER" else empty end),
        (if (.modmask      | floor) % 2 == 1 then "SHIFT" else empty end),
        (if (.modmask / 4  | floor) % 2 == 1 then "CTRL"  else empty end),
        (if (.modmask / 8  | floor) % 2 == 1 then "ALT"   else empty end)] | join(" ")) as $mods |
      (if .keycode == 0 then .key else "code:\(.keycode)" end) as $key |
      [$mods, $key, (.description // ""), (.dispatcher // ""), (.arg // "")] | join("\u001f")
    '
}

# "MODS + KEY → action" lines: the bind description when set, else the
# dispatcher + arg (XML-escaped so walker renders it literally)
parse_bindings() {
  awk -F'\x1f' '
{
    key_combo = ($1 == "" ? $2 : $1 " + " $2);
    action = $3;

    if (action == "") {
        action = ($4 == "exec") ? $5 : $4 ($5 == "" ? "" : " " $5);
        gsub(/^[ \t]+|[ \t]+$/, "", action);

        gsub(/&/, "\\&amp;", action);
        gsub(/</, "\\&lt;", action);
        gsub(/>/, "\\&gt;", action);
        gsub(/"/, "\\&quot;", action);
        gsub(/'"'"'/, "\\&apos;", action);
    }

    if (action != "") {
        printf "%-35s → %s\n", key_combo, action;
    }
}'
}

output_keybindings() {
  build_keymap_cache
  dynamic_bindings | sort -u | parse_keycodes | parse_bindings | sort
}

if [[ $1 == "--print" || $1 == "-p" ]]; then
  output_keybindings
else
  monitor_height=$(hyprctl monitors -j | jq -r '.[] | select(.focused == true) | .height')
  menu_height=$((monitor_height * 40 / 100))

  output_keybindings |
    walker --dmenu -p 'Keybindings' --width 800 --height "$menu_height"
fi
